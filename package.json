{
  "name": "openmontage-ai",
  "version": "0.1.2",
  "description": "A local-first, open-source video editor for music-synchronized gaming montages.",
  "author": "ClipPulse contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/mulhans100-a11y/ClipPulse.git"
  },
  "homepage": "https://github.com/mulhans100-a11y/ClipPulse#readme",
  "bugs": {
    "url": "https://github.com/mulhans100-a11y/ClipPulse/issues"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:main && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "start": "electron .",
    "cli": "node dist/src/main/cli.js",
    "test": "npm run build:main && node --test dist/tests/*.test.js tests/*.test.cjs",
    "smoke-test": "node scripts/smoke-test.cjs",
    "agent-e2e": "npm run build:main && node scripts/agent-e2e.cjs",
    "benchmark:preview": "npm run build:main && node scripts/benchmark-preview.cjs",
    "evaluate:valorant-fixture": "npm run build:main && node scripts/evaluate-valorant-fixture.cjs",
    "evaluate:audio": "tsc -p tsconfig.audio-evaluation.json && node scripts/evaluate-audio-analysis.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "chokidar": "4.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.github.mulhans100a11y.clippulse",
    "productName": "ClipPulse",
    "afterPack": "scripts/copy-third-party-notices.cjs",
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tests/**",
      "LICENSE",
      "README.md",
      "DEPENDENCIES.md",
      "INSTALLATION.md",
      "AGENT_API.md",
      "MCP_SETUP.md",
      "QUALITY_CONTROL.md",
      "TIMELINE_PREVIEW.md",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Video;",
      "synopsis": "Local-first gaming montage editor",
      "maintainer": "ClipPulse contributors <mulhans100-a11y@users.noreply.github.com>"
    }
  }
}
